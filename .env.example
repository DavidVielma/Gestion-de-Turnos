# Conexión a PostgreSQL (Neon). En Vercel se crea sola al conectar Neon desde Storage.
DATABASE_URL=postgres://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clave para firmar la cookie de sesión (cualquier texto largo y aleatorio)
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Solo para migrar los datos antiguos (npm run migrate:supabase)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=tu-service-role-key
